---
import '../styles/global.css';

const { title = 'Resources', description = 'Explore teachings and study material from CLF Church.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · CLF Church</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="CLF Church Resources home">
          <span class="brand-mark">CLF</span>
          <span class="brand-word">CHURCH</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/">Browse</a>
          <a href={Astro.url.pathname === '/' ? '#home-search' : '/#home-search'}>Search</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>CLF Church Resources</span>
        <a href="/">Back to resources <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </body>
</html>
