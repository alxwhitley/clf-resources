---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Resource not found" description="This resource page is unavailable.">
  <section class="shell page-intro missing-page">
    <h1>We couldn't find that page.</h1>
    <p>The resource may have moved or may no longer be available. Browse the library or try a new search.</p>
    <div class="missing-actions">
      <a href="/">Browse resources</a>
      <a href="/#home-search">Search the library</a>
    </div>
  </section>
</SiteLayout>
